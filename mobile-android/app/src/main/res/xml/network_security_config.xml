<?xml version="1.0" encoding="utf-8"?>
<!-- Em release: só HTTPS, TLS verificado. Em debug: libera cleartext pra testar
     contra o JARVIS na rede local. A validação do certificado NUNCA é desativada. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
    <!-- Android nao entende CIDR em <domain>: cada IP tem que ser listado.
         Exemplos de desenvolvimento; troque pela rede da sua instalação. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">192.168.50.1</domain>
        <domain includeSubdomains="false">192.168.50.2</domain>
        <domain includeSubdomains="false">192.168.50.3</domain>
        <domain includeSubdomains="false">192.168.50.4</domain>
        <domain includeSubdomains="false">192.168.50.5</domain>
        <domain includeSubdomains="false">192.168.50.6</domain>
        <domain includeSubdomains="false">192.168.50.7</domain>
        <domain includeSubdomains="false">192.168.50.8</domain>
        <domain includeSubdomains="false">192.168.50.9</domain>
        <domain includeSubdomains="false">192.168.50.10</domain>
        <domain includeSubdomains="false">192.168.50.20</domain>
        <domain includeSubdomains="false">192.168.50.100</domain>
        <domain includeSubdomains="false">192.168.50.101</domain>
        <domain includeSubdomains="false">192.168.50.102</domain>
        <domain includeSubdomains="false">192.168.50.200</domain>
        <domain includeSubdomains="false">seu-servidor-tailscale</domain>
    </domain-config>
</network-security-config>
